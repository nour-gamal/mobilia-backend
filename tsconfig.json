{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"baseUrl": "./src",
		"paths": {
			"@db/*": ["database/*"]
		}
	},
	"include": ["src"]
}
